<header id="top-header">
  <span class="siteName">
    <a href="/" title="Return to Home Page">CSE 340 App</a>
  </span>

  <div id="tools">
    <% if (!locals.loggedin) { %>
      <a title="Click to log in" href="/account/login">My Account</a>
    <% } %>

    <% if (locals.loggedin) { %>
      <a href="/account/">Welcome <%= locals.accountData.account_firstname %></a>
      |
      <a href="/account/logout">Logout</a>
    <% } %>
  </div>
</header>
