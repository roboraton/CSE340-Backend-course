<section class="delete-confirm">

  <h1><%= title %></h1>

  <%- messages() %>

  <p class="warning">
    Confirm Deletion — This action is permanent and cannot be undone.
  </p>

  <form method="post" action="/inv/delete/<%= inventory.inv_id %>">
    

    <label for="inv_make">Make</label>
    <input
      type="text"
      id="inv_make"
      name="inv_make"
      value="<%= inventory.inv_make %>"
      readonly
    >

    <label for="inv_model">Model</label>
    <input
      type="text"
      id="inv_model"
      name="inv_model"
      value="<%= inventory.inv_model %>"
      readonly
    >

    <label for="inv_year">Year</label>
    <input
      type="number"
      id="inv_year"
      name="inv_year"
      value="<%= inventory.inv_year %>"
      readonly
    >

    <label for="inv_price">Price</label>
    <input
      type="number"
      step="0.01"
      id="inv_price"
      name="inv_price"
      value="<%= inventory.inv_price %>"
      readonly
    >

    <!-- REQUIRED hidden field -->
    <input
      type="hidden"
      name="inv_id"
      value="<%= inventory.inv_id %>"
    >

    <button type="submit">Delete</button>
  </form>

</section>
