<section class="account account-logged">
  <div class="account-logged-card">
    <h1><%= title %></h1>

    <%- messages() %>

    <% if (errors) { %>
      <ul class="notice">
        <% errors.array().forEach(error => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <!-- Saludo -->
    <h2>Welcome <%= accountData.account_firstname %></h2>

    <!-- Update account (siempre visible) -->
    <p>
      <a class="btn btn-primary" href="/account/update/<%= accountData.account_id %>">
        Update Account Information
      </a>
    </p>

    <!-- Solo Employee o Admin -->
    <% if (accountData.account_type === "Employee" || accountData.account_type === "Admin") { %>

      <h3>Inventory Management</h3>

      <p>
        <a href="/inv/">Manage Inventory</a>
      </p>

    <% } %>

  </div>
</section>
